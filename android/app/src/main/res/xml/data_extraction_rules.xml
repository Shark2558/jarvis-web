<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/data_extraction_rules.xml - R7 D22: backups are off
     (allowBackup="false"); Android 12 and newer read these rules for cloud backup and for
     device-to-device transfer, and they exclude everything. The phone key and the SOS numbers'
     key live in the phone's secure hardware and never move anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
