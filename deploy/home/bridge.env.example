# The bridge's private settings. The setup script writes the real bridge.env from this file.
# bridge.env stays on this laptop: JARVIS never sees the Home Assistant token or these passwords,
# and the download kit never contains them.
JARVIS_URL=https://your-jarvis.example.run.app
HA_URL=http://host.docker.internal:8123
HA_TOKEN=
MQTT_USER=bridge
MQTT_PASSWORD=
# Photos and faces (R11.1). PHOTOS_DIR: a folder of photos on this laptop the bridge may READ to
# find faces (never changed; nothing leaves this laptop). Empty = off. Set it with
#   powershell -ExecutionPolicy Bypass -File .\setup-windows.ps1 -PhotosDir "C:\Users\you\Pictures\JARVIS"
PHOTOS_DIR=
# Days an unnamed group of faces is kept on this laptop before it is forgotten (1 to 3650).
FACE_GROUPS_KEEP_DAYS=90
