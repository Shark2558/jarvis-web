{"id": "m13", "kind": "rate_limited", "owner": "Find a bakery", "setup": {"google_error": {"status": 429, "error": {"code": 429, "message": "Quota exceeded for quota metric 'SearchText requests'", "status": "RESOURCE_EXHAUSTED", "details": [{"@type": "type.googleapis.com/google.rpc.ErrorInfo", "reason": "RATE_LIMIT_EXCEEDED", "domain": "googleapis.com", "metadata": {"service": "places.googleapis.com", "quota_metric": "places.googleapis.com/search_text_requests", "quota_limit": "SearchTextRequestsPerMinutePerProject", "quota_limit_value": "600", "consumer": "projects/123456789"}}]}}}, "calls": [{"name": "maps_search", "arguments": {"query": "bakery"}}], "expect": {"places_sent": 1, "not_latched": "maps_search", "error_has": "busy"}}
