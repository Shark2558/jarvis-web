{"id": "m10", "kind": "turn_cap", "owner": "Find 5 different kinds of shop", "calls": [{"name": "maps_search", "arguments": {"query": "shop 1"}}, {"name": "maps_search", "arguments": {"query": "shop 2"}}, {"name": "maps_search", "arguments": {"query": "shop 3"}}, {"name": "maps_search", "arguments": {"query": "shop 4"}}, {"name": "maps_route", "arguments": {"from": "a", "to": "b"}}], "expect": {"places_sent": 3, "routes_sent": 0, "error_has": "3 Maps"}}
