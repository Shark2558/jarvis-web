# Copy to .env — never commit .env
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false

# API auth (mandatory outside dev)
JARVIS_API_TOKEN=

# LLM
JARVIS_LLM_BACKEND=anthropic
JARVIS_ANTHROPIC_API_KEY=
JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_MODEL_BALANCED=claude-sonnet-5-5
JARVIS_MODEL_STRONG=claude-opus-5-5
JARVIS_DEFAULT_TIER=balanced
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1024

# Session memory
JARVIS_SESSION_BACKEND=memory          # memory | redis
JARVIS_REDIS_URL=redis://localhost:6379/0
JARVIS_SESSION_TTL_S=86400
JARVIS_SESSION_MAX_TURNS=40
JARVIS_SESSION_MAX_CHARS=48000

# Persona
JARVIS_USER_HONORIFIC=Sir
JARVIS_USER_TIMEZONE=Asia/Kolkata
