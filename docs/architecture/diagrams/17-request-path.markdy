scene "Figure 17 · A request through the layers" theme=paper type=sequence
layout LR

browser L1 "L1 API and sign-in"
service L2 "L2 Input"
service L3 "L3 Context"
service L4 "L4 Brain"
service L5 "L5 Skill tool"
gateway L6 "L6 Gateway"
database L7 "L7 Data"
alert L8 "L8 Output"

beat inbound "1. In":
  show $nodes stagger=30ms
  L1 -> L2 "speech or file to text"
  L1 -> L3 "owner checked, body capped"
  L3 -> L7 "load the session"
  L3 -> L4 "window plus notes"

beat reason "2. Reason and act":
  L4 -> L4 "monthly limit, then the model"
  L4 -> L6 "tool call with its risk"
  L6 -> L5 "allowed: run it"
  L6 -> L7 "audit, chained"
  L4 <- L6 "result fenced, or a card"

beat outbound "3. Out":
  L4 -> L7 "store the turn, add the cost"
  L1 <- L4 "the reply"
  L6 ~> L8 "activity, alerts later"
  glow L6 color=#22c55e

player:
  chrome:
    badge false
