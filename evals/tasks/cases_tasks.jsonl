{"id": "t01", "desc": "open tasks across lists; overdue flagged in the owner's zone; done ones left out", "question": "What's on my to-do list?", "mock_call": {"name": "tasks_list", "arguments": {}}, "expect": {"result_contains": ["Pay electricity bill", "Review RFP", "\"overdue\": true", "<<EXTERNAL CONTENT from to-do list"], "result_absent": ["Old done thing"]}}
{"id": "t02", "desc": "due on or before today (inclusive), checked locally too", "question": "What do I need to do today?", "mock_call": {"name": "tasks_list", "arguments": {"due_before": "2027-01-15"}}, "expect": {"result_contains": ["Pay electricity bill", "Call plumber"], "result_absent": ["Review RFP", "learn Rust"]}}
{"id": "t03", "desc": "one list by name, any case", "question": "What's on my work list?", "mock_call": {"name": "tasks_list", "arguments": {"list": "work"}}, "expect": {"result_contains": ["Review RFP", "learn Rust"], "result_absent": ["Call plumber"]}}
{"id": "t04", "desc": "completed tasks only when asked (and the ones done in the apps too)", "question": "Show everything including done items", "mock_call": {"name": "tasks_list", "arguments": {"include_completed": true}}, "expect": {"result_contains": ["Old done thing", "\"done\": true"]}}
{"id": "t05", "desc": "a due date is a date: never shifted into another zone", "tz": "America/Los_Angeles", "question": "What's due?", "mock_call": {"name": "tasks_list", "arguments": {}}, "expect": {"result_contains": ["\"today\": \"2027-01-14\"", "\"due\": \"2027-01-15\""]}}
{"id": "t06", "desc": "add with a date: sent as a date at midnight UTC", "question": "Add 'Buy milk' for 20 January", "mock_call": {"name": "task_add", "arguments": {"title": "Buy milk", "due": "2027-01-20"}}, "expect": {"mutations": [{"kind": "insert", "list": "L1", "body": {"title": "Buy milk", "due": "2027-01-20T00:00:00.000Z"}}], "result_contains": []}}
{"id": "t07", "desc": "add with a time: the owner's date is kept and the dropped time is said", "question": "Remind me to call the bank at 10 pm UTC on the 20th", "mock_call": {"name": "task_add", "arguments": {"title": "Call bank", "due": "2027-01-20T22:00:00Z"}}, "expect": {"result_contains": ["2027-01-21", "date only"], "mutations": [{"kind": "insert", "body": {"due": "2027-01-21T00:00:00.000Z"}}]}}
{"id": "t08", "desc": "add to a named list", "question": "Add 'Draft SoW' to my Work list", "mock_call": {"name": "task_add", "arguments": {"title": "Draft SoW", "list": "Work"}}, "expect": {"result_contains": ["L2:"], "mutations": [{"kind": "insert", "list": "L2"}]}}
{"id": "t09", "desc": "an unknown list adds nothing and names the real lists", "question": "Add 'eggs' to Groceries", "mock_call": {"name": "task_add", "arguments": {"title": "eggs", "list": "Groceries"}}, "expect": {"result_contains": ["No to-do list called", "My Tasks", "Work"], "mutations": []}}
{"id": "t10", "desc": "update changes only the title", "question": "Rename the plumber task", "mock_call": {"name": "task_update", "arguments": {"task_id": "L1:t_today", "title": "Call the plumber"}}, "expect": {"mutations": [{"kind": "patch", "body": {"title": "Call the plumber"}}], "result_contains": []}}
{"id": "t11", "desc": "update can clear a due date", "question": "Remove the date from the plumber task", "mock_call": {"name": "task_update", "arguments": {"task_id": "L1:t_today", "due": ""}}, "expect": {"mutations": [{"kind": "patch", "body": {"due": null}}], "result_contains": []}}
{"id": "t12", "desc": "complete marks it done", "question": "I paid the electricity bill", "mock_call": {"name": "task_complete", "arguments": {"task_id": "L1:t_over"}}, "expect": {"result_contains": ["completed"], "mutations": [{"kind": "complete", "body": {"status": "completed"}}]}}
{"id": "t13", "desc": "delete waits with the real title; exactly one delete after approval", "question": "Delete the RFP task", "mock_call": {"name": "task_delete", "arguments": {"task_id": "L2:t_later"}}, "approve": true, "expect": {"pending": 1, "card_contains": ["Delete to-do “Review RFP”", "Due: Wed 20 Jan 2027", "List: “Work”"], "mutations": [], "after_approval": [{"kind": "delete", "list": "L2"}], "result_contains": []}}
{"id": "t14", "desc": "deleting a task assigned from Docs warns that the original goes too", "question": "Delete the clause task", "mock_call": {"name": "task_delete", "arguments": {"task_id": "L1:t_doc"}}, "expect": {"pending": 1, "card_contains": ["also deletes it there"], "mutations": [], "result_contains": []}}
{"id": "t15", "desc": "no Tasks permission: the list says how to grant it and asks Google nothing", "granted": false, "question": "What's on my to-do list?", "mock_call": {"name": "tasks_list", "arguments": {}}, "expect": {"result_contains": ["permission_needed", "Grant"], "requests": 0}}
{"id": "t16", "desc": "no Tasks permission: a delete proposes nothing and asks Google nothing", "granted": false, "question": "Delete the RFP task", "mock_call": {"name": "task_delete", "arguments": {"task_id": "L2:t_later"}}, "expect": {"pending": 0, "requests": 0, "mutations": [], "result_contains": ["Grant"]}}
{"id": "t17", "desc": "an id that tries to walk to another URL is refused before any call", "question": "Delete it", "mock_call": {"name": "task_delete", "arguments": {"task_id": "L1:../../users/@me/lists"}}, "expect": {"pending": 0, "requests": 0, "mutations": [], "result_contains": []}}
{"id": "t18", "desc": "a spoken add becomes a card (someone else in the room may have said it)", "channel": "voice", "question": "add buy milk", "mock_call": {"name": "task_add", "arguments": {"title": "Buy milk"}}, "expect": {"pending": 1, "card_contains": ["Add to-do “Buy milk”", "List: your default list"], "mutations": [], "result_contains": []}}
{"id": "t19", "desc": "a bare task id means the default list", "question": "Done with the plumber", "mock_call": {"name": "task_complete", "arguments": {"task_id": "t_today"}}, "expect": {"mutations": [{"kind": "complete", "list": "L1"}], "result_contains": []}}
