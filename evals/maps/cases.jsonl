{"id": "m06", "kind": "route", "owner": "How long to walk to the museum?", "calls": [{"name": "maps_route", "arguments": {"from": "East Fort", "to": "Napier Museum", "mode": "walk"}}], "expect": {"routes_sent": 1, "travel": "WALK", "pref": null, "link_mode": "walking"}}
{"id": "m07", "kind": "home_work", "owner": "How long to work?", "setup": {"home": "Kowdiar, Thiruvananthapuram", "work": "Technopark Phase 3"}, "calls": [{"name": "maps_route", "arguments": {"from": "home", "to": "work"}}], "expect": {"routes_sent": 1, "origin": "Kowdiar, Thiruvananthapuram", "destination": "Technopark Phase 3", "card_from": "Home", "card_to": "Work"}}
