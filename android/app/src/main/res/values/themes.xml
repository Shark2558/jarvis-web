<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/values/themes.xml - R7 D0: the native screens on the console's
     Night background. The launchers are see-through: Chrome draws JARVIS a moment later. -->
<resources>
    <style name="Theme.Jarvis" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="android:colorBackground">@color/jarvis_bg</item>
        <item name="android:colorAccent">@color/jarvis_accent</item>
        <item name="android:colorPrimary">@color/jarvis_bg</item>
        <item name="android:textColorPrimary">@color/jarvis_ink</item>
        <item name="android:textColorSecondary">@color/jarvis_ink_2</item>
        <item name="android:textColorHint">@color/jarvis_ink_2</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Jarvis.Launch" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Jarvis.Title" parent="">
        <item name="android:textColor">@color/jarvis_ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Jarvis.Body" parent="">
        <item name="android:textColor">@color/jarvis_ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Jarvis.Small" parent="">
        <item name="android:textColor">@color/jarvis_ink_2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Jarvis.Button" parent="">
        <item name="android:background">@drawable/button_accent</item>
        <item name="android:textColor">@color/jarvis_on_accent</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Jarvis.Button.Quiet" parent="Jarvis.Button">
        <item name="android:background">@drawable/button_quiet</item>
        <item name="android:textColor">@color/jarvis_ink</item>
    </style>
</resources>
