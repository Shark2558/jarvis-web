<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/backup_rules.xml - R7 D22: Android 9 to 11 read these rules
     (Android 12 and newer read data_extraction_rules.xml); backups are off and they exclude
     everything as well. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
