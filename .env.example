# Copy to .env — never commit .env
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false

# API auth (mandatory outside dev)
JARVIS_API_TOKEN=

# LLM
JARVIS_LLM_BACKEND=anthropic
JARVIS_ANTHROPIC_API_KEY=
JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_MODEL_BALANCED=claude-sonnet-5-5
JARVIS_MODEL_STRONG=claude-opus-5-5
JARVIS_GEMINI_API_KEY=                 # optional second brain (free tier; Google may train on prompts)
# Optional OpenAI-compatible brain (Groq / OpenRouter / Ollama / LM Studio). Shown as its own entry in the dropdown.
JARVIS_OPENAI_COMPAT_BASE_URL=         # e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1
JARVIS_OPENAI_COMPAT_API_KEY=          # leave empty for local servers
JARVIS_OPENAI_COMPAT_MODEL_BALANCED=   # e.g. llama-3.3-70b-versatile
JARVIS_OPENAI_COMPAT_LABEL=Custom
JARVIS_OPENAI_COMPAT_TRAINS_ON_CONTENT=true   # private by default; set false only if the vendor does not train
JARVIS_LLM_TIMEOUT_S=20
JARVIS_DEFAULT_TIER=balanced
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1024

# Session memory
JARVIS_SESSION_BACKEND=memory          # memory | redis
JARVIS_REDIS_URL=redis://localhost:6379/0
JARVIS_SESSION_TTL_S=86400
JARVIS_SESSION_MAX_TURNS=40
JARVIS_SESSION_MAX_CHARS=48000

# Persona
JARVIS_USER_HONORIFIC=Sir
JARVIS_USER_TIMEZONE=Asia/Kolkata

# Voice (slice 9): Google Cloud Text-to-Speech + Speech-to-Text v1 with Application Default
# Credentials (Cloud Run: the jarvis-run account; locally: gcloud auth application-default login).
# Off, or without credentials, the console uses the browser's own voice. Free up to Google's
# monthly allowance, then priced in rupees against the monthly limit.
JARVIS_VOICE_CLOUD=true
JARVIS_VOICE_LANGUAGE=en-IN            # speech-to-text language (the voices are en-GB)

# Web sign-in (owner only). auth_mode=token keeps bearer-token-only behaviour for local dev.
JARVIS_AUTH_MODE=token                 # token | google
JARVIS_PUBLIC_BASE_URL=http://localhost:8000
JARVIS_OWNER_EMAILS=                   # comma-separated Google accounts allowed to sign in
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_SESSION_SECRET=                 # >=32 random chars; python -c "import secrets;print(secrets.token_urlsafe(48))"
JARVIS_RATE_LIMIT_PER_MINUTE=120

# Google Calendar + Gmail tools (slice 6). Need auth_mode=google; the owner links the account from
# the console (panel -> Integrations -> Connect Google). Tokens are encrypted with this key.
JARVIS_GOOGLE_TOOLS_ENABLED=true
JARVIS_TOKEN_KEY=                      # base64 of 32 random bytes; python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
