# Copy to .env — never commit .env
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false

# API auth (mandatory outside dev)
JARVIS_API_TOKEN=

# LLM
JARVIS_LLM_BACKEND=anthropic
JARVIS_ANTHROPIC_API_KEY=
JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_MODEL_BALANCED=claude-sonnet-5-5
JARVIS_MODEL_STRONG=claude-opus-5-5
JARVIS_GEMINI_API_KEY=                 # optional second brain (free tier; Google may train on prompts)
# Optional OpenAI-compatible brain (Groq / OpenRouter / Ollama / LM Studio). Shown as its own entry in the dropdown.
JARVIS_OPENAI_COMPAT_BASE_URL=         # e.g. https://api.groq.com/openai/v1  or  http://localhost:11434/v1
JARVIS_OPENAI_COMPAT_API_KEY=          # leave empty for local servers
JARVIS_OPENAI_COMPAT_MODEL_BALANCED=   # e.g. llama-3.3-70b-versatile
JARVIS_OPENAI_COMPAT_LABEL=Custom
JARVIS_OPENAI_COMPAT_TRAINS_ON_CONTENT=true   # private by default; set false only if the vendor does not train
JARVIS_LLM_TIMEOUT_S=20
JARVIS_DEFAULT_TIER=balanced
JARVIS_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=1024

# Session memory
JARVIS_SESSION_BACKEND=memory          # memory | redis
JARVIS_REDIS_URL=redis://localhost:6379/0
JARVIS_SESSION_TTL_S=86400
JARVIS_SESSION_MAX_TURNS=40
JARVIS_SESSION_MAX_CHARS=48000

# Persona
JARVIS_USER_HONORIFIC=Sir
JARVIS_USER_TIMEZONE=Asia/Kolkata

# Voice (slice 9): Google Cloud Text-to-Speech + Speech-to-Text v1 with Application Default
# Credentials (Cloud Run: the jarvis-run account; locally: gcloud auth application-default login).
# Off, or without credentials, the console uses the browser's own voice. Free up to 90 % of
# Google's monthly allowance (counted once for this deployment, on Pacific-time months like
# Google's), then priced in rupees against the monthly limit.
JARVIS_VOICE_CLOUD=true
JARVIS_VOICE_LANGUAGE=en-IN            # speech-to-text language (the voices are en-GB)
# Google's free tier is per BILLING ACCOUNT. If that billing account is shared with other
# projects or apps that use Text-to-Speech / Speech-to-Text, JARVIS can't see their use: set
#   JARVIS_VOICE_TTS_FREE_CHARS=0
#   JARVIS_VOICE_STT_FREE_SECONDS=0
# so every cloud-voice call is priced against your monthly limit. Defaults: 900000 and 3240.
# JARVIS_VOICE_TTS_FREE_CHARS=900000
# JARVIS_VOICE_STT_FREE_SECONDS=3240

# Web sign-in (owner only). auth_mode=token keeps bearer-token-only behaviour for local dev.
JARVIS_AUTH_MODE=token                 # token | google
# Also the passkey relying party (slice 10 D): RP ID = its host, so open the console at exactly
# this address (localhost works, an IP address does not). Changing it later invalidates passkeys.
JARVIS_PUBLIC_BASE_URL=http://localhost:8000
JARVIS_OWNER_EMAILS=                   # comma-separated Google accounts allowed to sign in
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_SESSION_SECRET=                 # >=32 random chars; python -c "import secrets;print(secrets.token_urlsafe(48))"
JARVIS_RATE_LIMIT_PER_MINUTE=120

# Google Calendar + Gmail tools (slice 6). Need auth_mode=google; the owner links the account from
# the console (panel -> Integrations -> Connect Google). Tokens are encrypted with this key.
JARVIS_GOOGLE_TOOLS_ENABLED=true
JARVIS_TOKEN_KEY=                      # base64 of 32 random bytes; python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# Web search with numbered sources (slice 10 B): Tavily, free plan (1,000 credits a month, no
# card). Without a key the web tools are not registered and JARVIS says web search is not set up.
# JARVIS stops at 900 a month for this deployment and never uses pay-as-you-go. Cloud Run: secret
# jarvis-tavily-key (deploy/cloudrun.sh asks for it once).
JARVIS_TAVILY_API_KEY=                 # tvly-...
JARVIS_WEB_SEARCH_ENABLED=true

# Google Drive, chosen folders only (slice 12 D1): JARVIS reads, as its own Cloud Run service
# account, only folders the owner shares with it and switches on in Integrations. Needs Cloud Run's
# metadata server and the Drive API; deploy/cloudrun.sh sets it on only when it could switch that
# API on. Off: no drive_* tools, /v1/drive says not configured.
JARVIS_DRIVE=off                       # on | off

# Maps + YouTube (slice 12 D2-D4): ONE server-side Google API key, restricted to Places API (New),
# Routes API and YouTube Data API v3 (deploy/cloudrun.sh makes jarvis-maps-yt and keeps it in
# Secret Manager). It never reaches the browser. Without it: no maps_* / youtube_search tools.
JARVIS_GOOGLE_API_KEY=
# Google's Maps price list for the billing account: global (default, the smaller free allowance:
# 4,500 searches / car routes a month after JARVIS's 90 % stop) or india (35,000 -> 31,500; only
# for a billing account in India that bills in rupees). A wrong guess only stops early.
JARVIS_MAPS_PRICING=global

# R2 - memory and personal vault (docs/plans/r2-memory-vault.md). All three need JARVIS_TOKEN_KEY
# above (keys are derived from it; nothing is ever stored in clear): without it they are OFF and
# their panels say "Not available on this server (no encryption key)". The vault keeps files as
# encrypted chunks in Firestore (<= 10 MB a file, total below); opening one needs the passkey (or a
# Google sign-in under 5 minutes old) and lasts JARVIS_VAULT_UNLOCK_MINUTES. DigiLocker import
# uses JARVIS_DRIVE (a folder you share with JARVIS and pick in Integrations -> Google Drive).
JARVIS_VAULT_ENABLED=true
JARVIS_VAULT_MAX_TOTAL_MB=150            # 10-500
JARVIS_VAULT_UNLOCK_MINUTES=10           # 2-30
JARVIS_NOTES_ENABLED=true                # notes, voice-memo transcripts, links
JARVIS_BELONGINGS_ENABLED=true           # "Where did I keep it?" (Things)
