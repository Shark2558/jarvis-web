<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/layout/activity_no_browser.xml - R7 D1: with no browser that can draw
     JARVIS full screen, one plain screen (the library's WebView fallback stays off). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nobrowser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">
    <TextView
        style="@style/Jarvis.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="title"
        android:text="@string/nobrowser_title" />
    <TextView
        style="@style/Jarvis.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/row_gap"
        android:text="@string/nobrowser_body" />
    <Button
        android:id="@+id/nobrowser_store"
        style="@style/Jarvis.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/nobrowser_button" />
    <TextView
        android:id="@+id/nobrowser_status"
        style="@style/Jarvis.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
