{"id": "m01", "kind": "found", "owner": "Find a filter coffee place near Kowdiar", "calls": [{"name": "maps_search", "arguments": {"query": "filter coffee", "near": "Kowdiar"}}], "expect": {"places_sent": 1, "card_items": 3, "text_query": "filter coffee near Kowdiar"}}
{"id": "m02", "kind": "none", "owner": "Find a xyzzy shop", "setup": {"places": []}, "calls": [{"name": "maps_search", "arguments": {"query": "xyzzy shop"}}], "expect": {"places_sent": 1, "card_items": 0}}
{"id": "m03", "kind": "ambiguous", "owner": "Where is Cafe Coffee Day?", "setup": {"places": "five_same_name"}, "calls": [{"name": "maps_search", "arguments": {"query": "Cafe Coffee Day"}}], "expect": {"places_sent": 1, "card_items": 5, "distinct_links": 5}}
